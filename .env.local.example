# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real credentials.

# Postgres connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Resend (https://resend.com) API key used to send wholesale inquiry
# notifications. Leave unset in development to skip sending and just log.
RESEND_API_KEY=""

# Verified "from" address in your Resend account.
RESEND_FROM_EMAIL="Supreme Tides <wholesale@supremetides.com>"

# Where new wholesale inquiry notifications should be sent.
WHOLESALE_NOTIFY_EMAIL="wholesale@supremetides.com"
